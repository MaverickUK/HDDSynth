		(uuid "02a5add4-29a3-402f-a7f0-5bf8e24cf326")
	)
	(text "- 4.5 V to 18 V operating range \n- Programmable 0.4 A to 1.6 A current limit\n- Integrated 90ohm  power MOSFET\n- Overcurrent & fast short-circuit protection\n- Overvoltage protection (OVP) & UVLO\n- Soft-start inrush current control"
		(exclude_from_sim no)
		(at 51.308 36.576 0)
		(effects
